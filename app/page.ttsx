/* -------------------------------------------------------------------------- */
/*  Card – L-shaped (72×72 notch top-left) with an inverted fillet             */
/* -------------------------------------------------------------------------- */

function Card({ app }: { app: App }) {
  const { name, lines, Icon } = app;
  return (
    <li className="relative w-[192px] shrink-0 list-none">
      {/* tab (right, rises above the body) */}
      <div
        className="absolute left-[72px] right-0 top-0 h-[84px] rounded-tl-[10px] rounded-tr-[12px]"
        style={{ background: CARD }}
      />
      {/* inverted corner where tab meets body */}
      <div
        className="absolute left-[62px] top-[62px] h-[10px] w-[10px]"
        style={{ background: `radial-gradient(circle at 0 0, transparent 9.5px, ${CARD} 10px)` }}
      />
      {/* body */}
      <div className="relative mt-[72px] rounded-[12px] px-[22px] pb-[23px] pt-[26px]" style={{ background: CARD }}>
        <h3 className="text-[16px] font-bold uppercase leading-[20px] tracking-[-0.05em] text-[#f6f6f5]">{name}</h3>
        <p className="mt-[11px] text-[13px] font-semibold leading-[21.5px] text-[#82878a]">
          {lines.map((l) => (
            <span key={l} className="block whitespace-nowrap">
              {l}
            </span>
          ))}
        </p>
      </div>
      {/* icon sits in the notch */}
      <div className="absolute left-[12px] top-[12px] h-[48px] w-[48px]">
        <Icon />
      </div>
      {/* star */}
      <svg className="absolute right-[17px] top-[17px]" viewBox="0 0 10 10" width="10" height="10" aria-hidden>
        <path d="M5 .6l1.3 2.9 3.1.3-2.3 2.1.7 3.1L5 7.4 2.2 9l.7-3.1L.6 3.8l3.1-.3z" fill="#55585a" />
      </svg>
    </li>
  );
}

/* -------------------------------------------------------------------------- */
/*  Auto-scrolling column                                                      */
/* -------------------------------------------------------------------------- */

const COPIES = 4; // 25% of the track height === exactly one list → seamless loop

function Column({
  apps,
  dir,
  duration,
  offset,
  gap,
  className,
}: {
  apps: App[];
  dir: "up" | "down";
  duration: number;
  offset: number; // y (px) of the first card in the first frame
  gap: number;
  className: string;
}) {
  return (
    <div className={`relative shrink-0 overflow-hidden ${className}`}>
      <div
        className={`col-track ${dir === "up" ? "col-up" : "col-down"}`}
        style={{ "--dur": `${duration}s`, "--o": `${offset}px` } as CSSProperties}
      >
        {Array.from({ length: COPIES }).map((_, i) => (
          <ul
            key={i}
            aria-hidden={i === 0 ? undefined : true}
            className="m-0 flex flex-col p-0"
            style={{ rowGap: gap, paddingBottom: gap }}
          >
            {apps.map((app) => (
              <Card key={app.name} app={app} />
            ))}
          </ul>
        ))}
      </div>
    </div>
  );
}

/* -------------------------------------------------------------------------- */
/*  Page                                                                       */
/* -------------------------------------------------------------------------- */

export default function Page() {
  return (
    <main className={`${sans.variable} ${mono.variable} font-[family-name:var(--font-sans)] bg-[#111111]`}>
      <style>{`
        .col-track { will-change: transform; transform: translateY(var(--o, 0px)); }
        .col-up   { animation: col-up   var(--dur, 40s) linear infinite; }
        .col-down { animation: col-down var(--dur, 40s) linear infinite; }
        .col-track:hover { animation-play-state: paused; }

        /* 4 identical copies → 25% of the track = one full list */
        @keyframes col-up {
          from { transform: translateY(calc(-25% + var(--o, 0px))); }
          to   { transform: translateY(calc(-50% + var(--o, 0px))); }
        }
        @keyframes col-down {
          from { transform: translateY(calc(-50% + var(--o, 0px))); }
          to   { transform: translateY(calc(-25% + var(--o, 0px))); }
        }
        @media (prefers-reduced-motion: reduce) {
          .col-up, .col-down { animation: none; }
        }

        /* mobile / tablet: simple top + bottom fade */
        .fade-mask {
          -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 100px, #000 calc(100% - 150px), transparent 100%);
          mask-image: linear-gradient(to bottom, transparent 0, #000 100px, #000 calc(100% - 150px), transparent 100%);
        }

        /* desktop: columns are clipped to the dark stair and share ONE global fade (measured) */
        @media (min-width: 1280px) {
          .fade-mask {
            clip-path: polygon(
              0 132px,
              calc(50% - 192px) 132px, calc(50% - 192px) 84px,
              calc(50% + 192px) 84px,  calc(50% + 192px) 36px,
              100% 36px, 100% 1056px,
              calc(50% + 192px) 1056px, calc(50% + 192px) 1104px,
              calc(50% - 192px) 1104px, calc(50% - 192px) 1152px,
              0 1152px
            );
            -webkit-mask-image: linear-gradient(to bottom,
              transparent 0, transparent 52px, #000 160px,
              #000 988px, rgba(0,0,0,.85) 1000px, rgba(0,0,0,.65) 1012px, rgba(0,0,0,.5) 1024px,
              rgba(0,0,0,.4) 1036px, rgba(0,0,0,.25) 1048px, rgba(0,0,0,.1) 1060px,
              rgba(0,0,0,.05) 1084px, transparent 1100px);
            mask-image: linear-gradient(to bottom,
              transparent 0, transparent 52px, #000 160px,
              #000 988px, rgba(0,0,0,.85) 1000px, rgba(0,0,0,.65) 1012px, rgba(0,0,0,.5) 1024px,
              rgba(0,0,0,.4) 1036px, rgba(0,0,0,.25) 1048px, rgba(0,0,0,.1) 1060px,
              rgba(0,0,0,.05) 1084px, transparent 1100px);
          }
        }
      `}</style>





      <div style={{ width: '100%', height: '600px', position: 'relative' }}>
        <GradientASCII
          colors={["#e94b20", "#fff6f2", "#ffc2ad", "#ff8a65"]}
          shape="horizon"
          characters=" .·•●"
          cellSize={18}
          density={0.8}
          glyphOpacity={0.85}
          glow={0.2}
          depthOfField={0}
          flicker={0.2}
          softness={0.5}
          scale={1}
          flow={0.5}
          speed={1}
          gradientOpacity={0.9}
          grain={0.08}
          variation={0}
          mouseInteraction
          scrambleRadius={0.1}
          clickEffect="wave"
          intro
          lightMode={false}
        />
      </div>
      <section className="relative isolate overflow-hidden bg-[#131416] xl:h-[1208px] xl:bg-[#eae7e1]">
        {/* ------------------------------------------------------------------ */}
        {/*  Stepped dark background with inverted corners (desktop)            */}
        {/* ------------------------------------------------------------------ */}
        <div aria-hidden className="pointer-events-none absolute inset-0 -z-10 hidden xl:block">
          {/* lighter beige below the section midpoint (hidden behind the dark blocks) */}
          <div className="absolute inset-x-0 bottom-0 top-1/2 bg-[#f4f3f0]" />

          {/* A */}
          <div className="absolute left-0 right-[calc(50%+192px)] top-[132px] h-[1020px] rounded-br-[12px] bg-[#131416]" />
          {/* B */}
          <div className="absolute left-[calc(50%-192px)] top-[84px] h-[1020px] w-[384px] rounded-br-[12px] rounded-tl-[12px] bg-[#131416]" />
          {/* C */}
          <div className="absolute left-[calc(50%+192px)] right-0 top-[36px] h-[1020px] rounded-tl-[12px] bg-[#131416]" />

          {/* inverted fillets (r = 12) */}
          <div
            className="absolute left-[calc(50%-204px)] top-[120px] h-[12px] w-[12px]"
            style={{ background: `radial-gradient(circle at 0 0, transparent 11.5px, ${BG} 12px)` }}
          />
          <div
            className="absolute left-[calc(50%+180px)] top-[72px] h-[12px] w-[12px]"
            style={{ background: `radial-gradient(circle at 0 0, transparent 11.5px, ${BG} 12px)` }}
          />
          <div
            className="absolute left-[calc(50%-192px)] top-[1104px] h-[12px] w-[12px]"
            style={{ background: `radial-gradient(circle at 100% 100%, transparent 11.5px, ${BG} 12px)` }}
          />
          <div
            className="absolute left-[calc(50%+192px)] top-[1056px] h-[12px] w-[12px]"
            style={{ background: `radial-gradient(circle at 100% 100%, transparent 11.5px, ${BG} 12px)` }}
          />
        </div>

        {/* ------------------------------------------------------------------ */}
        {/*  Content                                                            */}
        {/* ------------------------------------------------------------------ */}
        <div className="relative flex flex-col items-center gap-14 px-6 py-20 xl:static xl:block xl:p-0">
          {/* ---- left: copy ---- */}
          <div className="w-full max-w-[380px] xl:absolute xl:left-[calc(50%-552px)] xl:top-[310px] xl:z-10 xl:w-[380px] xl:max-w-none">
            <span className="inline-flex h-[32px] items-center rounded-full border border-[#3e4043] pl-[9px] pr-[8px] font-[family-name:var(--font-mono)] text-[11.2px] font-bold uppercase tracking-[0.125em] text-[#a8a39e]">
              Developers
            </span>

            <h2 className="mt-[16px] text-[30px] font-medium leading-[38px] tracking-[-0.067em] text-white xl:text-[36px] xl:leading-[44px]">
              Build on Bitcoin, the most <br className="hidden xl:block" />
              secure base layer
            </h2>

            <ul className="mt-[30px] p-0">
              {FEATURES.map(({ Icon, title, lines }) => (
                <li key={title} className="relative m-0 flex h-[100.67px] list-none items-start gap-[16px] max-xl:mb-6 max-xl:h-auto">
                  <div className="flex h-[32px] w-[32px] shrink-0 items-center justify-center overflow-hidden rounded-[8px] bg-[#27282c]">
                    <Icon />
                  </div>
                  <div className="-mt-[4.4px] min-w-0 font-[family-name:var(--font-mono)]">
                    <p className="text-[12.6px] font-bold leading-[16px] text-[#f8f8f8]">{title}</p>
                    <p className="mt-[13px] text-[14px] leading-[20.5px] text-[#82878a]">
                      {lines.map((l) => (
                        <span key={l} className="block xl:whitespace-nowrap">
                          {l}
                        </span>
                      ))}
                    </p>
                  </div>
                  <span
                    aria-hidden
                    className="absolute -top-[5px] left-[356px] hidden w-[12px] text-center font-[family-name:var(--font-mono)] text-[13px] leading-[16px] text-[#505156] xl:block"
                  >
                    +
                  </span>
                </li>
              ))}
            </ul>
          </div>

          {/* ---- right: three scrolling columns (up / down / up) ---- */}
          <div className="fade-mask relative flex h-[640px] w-full justify-center gap-[24px] overflow-hidden xl:absolute xl:inset-0 xl:z-10 xl:block xl:h-auto xl:w-auto xl:overflow-visible">
            <Column
              apps={COL_1}
              dir="up"
              duration={44}
              offset={88}
              gap={26}
              className="h-full w-[192px] xl:absolute xl:left-[calc(50%-72px)] xl:top-0 xl:h-[1208px]"
            />
            <Column
              apps={COL_2}
              dir="down"
              duration={52}
              offset={2}
              gap={30}
              className="h-full w-[192px] xl:absolute xl:left-[calc(50%+144px)] xl:top-0 xl:h-[1208px]"
            />
            <Column
              apps={COL_3}
              dir="up"
              duration={38}
              offset={56}
              gap={28}
              className="h-full w-[192px] xl:absolute xl:left-[calc(50%+360px)] xl:top-0 xl:h-[1208px]"
            />
          </div>
        </div>
      </section>
    </main>
  );
}