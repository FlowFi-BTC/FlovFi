import GradientASCII from '../components/GradientASCII';
import type { ComponentType, CSSProperties } from "react";
import { Inter, JetBrains_Mono } from "next/font/google";

/* ========================================================================== */
/*  Design tokens (measured from the reference screenshot, drawn at 2x)       */
/*                                                                            */
/*  Section ........ 1208px tall                                              */
/*  Dark stair ..... 3 blocks, each 1020px tall, stepping UP by 48px          */
/*                   A: y 132→1152 | B: y 84→1104 | C: y 36→1056              */
/*                   steps sit at 50% ± 192px, corner radius 12px             */
/*                   (convex on the outside, inverted fillet on the inside)   */
/*  Cards .......... 192px wide, #27282b, L-shape (72×72 notch top-left)      */
/*  Columns ........ left edges at 50% −72 / +144 / +360, gutter 24px         */
/*  Page bg ........ #131416 | top beige #eae7e1 | bottom beige #f4f3f0       */
/* ========================================================================== */

